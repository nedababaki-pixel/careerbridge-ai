# Copy this file to .env and add your own values. Never commit .env.
# On the server, keep it readable only by the app user: chmod 600 .env

# Required: your Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=replace_with_your_key

# Optional settings (defaults shown)
GEMINI_MODEL=gemini-3.8-flash
# How much the model "thinks" before answering: minimal, low, medium or high.
# low keeps answers fast (higher levels can take over a minute). Leave empty to use the model's default.
GEMINI_THINKING_LEVEL=low
# Seconds to wait for the AI answer. Keep it below Gunicorn's timeout (120 s).
GEMINI_TIMEOUT=90
# Set to 1 only when the app runs behind Nginx (reads the real client IP and https scheme).
TRUST_PROXY=0
# Rate limits per client IP. Use a shared store (e.g. redis://localhost:6379) with several servers.
RATE_LIMIT_ANALYZE=5 per minute;50 per day
RATE_LIMIT_UPLOAD=10 per minute
RATELIMIT_STORAGE_URI=memory://
LOG_LEVEL=INFO
PORT=5055
